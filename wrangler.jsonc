{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "utvt-classroom",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "utvt-student-marks",
      "database_id": "6e7f2e19-28c2-455c-bb93-5124ea45bfca",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "utvt-student-documents"
    }
  ],
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 1000
  }
}


